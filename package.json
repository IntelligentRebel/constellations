{
  "name": "constellations",
  "version": "0.3.9.15",
  "description": "Constellations: a turn-based 4X space strategy game in the spirit of Stars! (1995), with a modern interface, playable offline in a browser.",
  "scripts": {
    "build": "node scripts/build.mjs --prod",
    "build:dev": "node scripts/build.mjs",
    "typecheck": "tsc -p .",
    "test": "node --import tsx --test tests/*.test.ts",
    "sim": "tsx scripts/sim.ts",
    "check": "tsx scripts/check.ts",
    "gen-data": "node scripts/gen-data.mjs",
    "fuzz": "tsx scripts/fuzz.ts 50 fz1 40"
  },
  "keywords": [],
  "author": "IntelligentRebel",
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^26.6.4",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.2",
    "preact": "^11.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@^5.9.3"
  },
  "private": true
}
